# ── ฐานข้อมูล ────────────────────────────────────────────────
# SQLite (เริ่มต้น)
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/off_kitkaset"
# MySQL / MariaDB (ต้องติดตั้งเพิ่ม: npm i @prisma/adapter-mariadb)
# DATABASE_URL="mysql://user:password@localhost:3306/off_kitkaset"

# ── เว็บไซต์ ─────────────────────────────────────────────────
SITE_URL="http://localhost:3000"

# ── หลังบ้าน ─────────────────────────────────────────────────
# ตั้งเป็น true เฉพาะเมื่อรันหลัง reverse proxy (nginx, Caddy, Cloudflare ฯลฯ) ที่เขียนทับ X-Forwarded-For
# เพื่อจำกัดการล็อกอินผิดต่อ IP ด้วย — ถ้าไม่มี proxy ห้ามตั้ง เพราะผู้ใช้ปลอม header นี้ได้
TRUST_PROXY="false"
# คีย์สำหรับเข้ารหัส session (สุ่มใหม่ด้วย: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
# บัญชีแอดมินเริ่มต้น (ใช้ตอนรัน npm run db:seed ครั้งแรกเท่านั้น)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
